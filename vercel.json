{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "Figma",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/workspaces", "permanent": false },
    { "source": "/Figma", "destination": "/workspaces", "permanent": true },
    { "source": "/Figma/:path*", "destination": "/:path*", "permanent": true }
  ]
}
